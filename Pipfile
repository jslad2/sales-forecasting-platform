[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# 1) Install Cython first so that downstream C extensions can compile
Cython = ">=0.29.21"

# 2) Prophet requires a Stan backend; we’ll use pystan here
pystan = "~=3.8.0"

# 3) Pin Prophet to a version known to include wheels for Python 3.9
prophet = "==1.1.4"

# 4) Pin pmdarima to a version that ships prebuilt wheels
pmdarima = "==2.0.3"

# 5) The rest of your data-science stack
streamlit = "==1.26.0"
pandas = "==1.5.3"
numpy = "==1.24.3"
xgboost = "==1.7.5"
matplotlib = "==3.7.1"
plotly = "==5.15.0"
statsmodels = "==0.13.5"
optuna = "==3.2.0"

# Any additional libraries you were using:
kiwisolver = "==1.4.4"
pyparsing = "==3.0.9"
fonttools = "==4.39.3"
fpdf = "==1.7.2"
convertdate = "==2.4.0"
pymeeus = "==0.5.11"
patsy = "==0.5.3"

[dev-packages]
pytest = "==7.2.2"
ipython = "==8.7.0"
jupyter = "==1.0.0"

[requires]
python_version = "3.9"
