import os
import json
import base64
from google.oauth2 import service_account
from google.auth.transport.requests import Request

# Load Base64 encoded credentials from environment
SERVICE_ACCOUNT_JSON_BASE64 = os.getenv("GOOGLE_APPLICATION_CREDENTIALS_BASE64")

if not SERVICE_ACCOUNT_JSON_BASE64:
    print("❌ ERROR: GOOGLE_APPLICATION_CREDENTIALS_BASE64 is not set.")
    exit(1)

# Decode Base64
decoded_json = base64.b64decode(SERVICE_ACCOUNT_JSON_BASE64).decode("utf-8")

# Load service account info
SERVICE_ACCOUNT_JSON = json.loads(decoded_json)

# Authenticate using the credentials
credentials = service_account.Credentials.from_service_account_info(
    SERVICE_ACCOUNT_JSON,
    scopes=["https://www.googleapis.com/auth/cloud-platform"]
)

# Refresh the token
auth_request = Request()
credentials.refresh(auth_request)

print(f"🔑 Access Token: {credentials.token}")
